// Go getters drop the `Get` prefix (Effective Go). A metavariable is a
// whole node, so `Get$NAME` cannot match part of an identifier: `let`
// derives the new name from the whole one. `where` keeps `Getaway`, which
// is not a getter, and the second rule renames the call sites.
refactor "go-getters" {
    match go::pattern 'func ($R $T) $F() $OUT { $$$B }' where $F matches /^Get[A-Z]/ {
        let $NAME = $F | strip_prefix("Get")
        replace 'func ($R $T) $NAME() $OUT { $$$B }'
    }
    match go::pattern '$X.$F()' where $F matches /^Get[A-Z]/ {
        let $NAME = $F | strip_prefix("Get")
        replace '$X.$NAME()'
    }
}
