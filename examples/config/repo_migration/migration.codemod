// One step of a repository convention, applied as a codemod: add a pre-push
// hook, enable a plugin for agents, refresh the managed part of AGENTS.md,
// and record the new profile version. Every rule is scoped to its file.
refactor "rust-profile-0002" {
    match toml::key "repos[repo=local].hooks[id=cargo-clippy]" in "prek.toml" {
        insert '{
    id = "cargo-clippy",
    entry = "cargo clippy --all-targets -- -D warnings",
    language = "system",
    pass_filenames = false,
    stages = ["pre-push"]
  }'
    }
    match json::key "/enabledPlugins/code-intelligence@gb-agent-skills" in ".claude/settings.json" { set 'true' }
    match markdown::block "myspec" in "AGENTS.md" {
        set '## myspec

- `myspec report` — compliance against the rust profile standards.
- `make check` runs clippy before every push.'
    }
    match toml::key "project.profile_version" in "myspec.toml" { set '2' }
}
