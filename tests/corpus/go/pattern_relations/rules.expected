1 go::pattern '$T.Fatal($$$A)' where any(inside 'go func() { $$$B }()', inside 'go func($P $Q) { $$$B }($E)') -> '$T.Error($$$A)'
1 go::pattern 'log.Println($S)' where $S matches /^"enter/, nth 1 -> delete
1 go::pattern 'if err != nil { return err }' where follows '$V, err := os.Stat($P)' directly -> 'if err != nil { return fmt.Errorf("stat: %w", err) }' requires import "fmt"
