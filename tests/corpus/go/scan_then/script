// A context goes first in every exported api function that can fail,
// and every caller passes one. Stage 1 changes the declarations in api/;
// `then`, a scan reads which functions now take a context (stage 1's
// output, in other files), and stage 2 changes only their call sites.
refactor "context-first" {
    match go::pattern 'func $F($$$P) error { $$$B }' in "api/**"
        where $F matches /^[A-Z]/, not $$$P matches /^ctx /
    {
        replace 'func $F(ctx context.Context, $$$P) error { $$$B }'
        requires import "context"
    }
    then {
        scan go::pattern 'func $F(ctx context.Context, $$$P) error { $$$B }' in "api/**" as takes_ctx
        // `Sum` returns no error and `local.Load` is not api's: both stay.
        match go::pattern 'api.$F($$$A)' where $F in takes_ctx, not $$$A matches /^ctx\b/ {
            replace 'api.$F(ctx, $$$A)'
        }
    }
}
