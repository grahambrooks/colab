// The whole pkg/errors -> fmt migration in one script: a pattern rewrites
// every call (nested ones included, in one pass), then the import-level
// rules drop the old package and add "fmt" where the new calls need it.
// Text inside comments and strings is not code and must not change.
refactor "pkg-errors-migration" {
    match go::pattern 'errors.Wrap($ERR, $MSG)' {
        replace 'fmt.Errorf("%s: %w", $MSG, $ERR)'
    }
    match go::pattern 'errors.Wrapf($ERR, $FMT, $$$ARGS)' {
        replace 'fmt.Errorf($FMT+": %w", $$$ARGS, $ERR)'
    }
    match go::import "github.com/pkg/errors" { delete }
    match go::import "fmt" { ensure }
}
