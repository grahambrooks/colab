// A file extension renamed wherever it is written: Rust strings and
// comments, shell, TOML and Markdown, in one rule. `word` leaves
// `.codemods`, a longer word, alone. The second rule drops a marker the
// old tool left in comments, in any language.
refactor "extension-rename" {
    match text::word ".codemod" { replace ".colab" }
    match text::literal " (generated by codemod-tool)" { delete }
}
