use crate::ast::Command;
use crate::ast::Item;
use crate::ast::Match;
use crate::ast::Namespace;
use crate::ast::Action;

grammar;

// Skip whitespace and `//` line comments. Block comments are
// intentionally not supported (yet) — they encourage commented-out
// rules, which we'd rather see deleted.
match {
    r"\s+" => { },
    r"//[^\n\r]*" => { },
} else {
    _
}

pub Program: Command = {
    "refactor" <name: StringLiteral> "{" <items: Item*> "}" => Command { refactor_name: name, items }
};

pub Item: Item = {
    <m: Match> => Item::Match(m),
    "include" <s: StringLiteral> => Item::Include(s),
};

// The optional `in "<glob>"` clause restricts the rule to matching
// paths. It is enforced through the operation's relevance check, so a
// scoped rule is skipped wholesale for files outside the glob.
pub Match: Match = {
    "match" <namespace: Namespace> <string: StringLiteral> <scope: Scope?> "{" <action: Action> "}" => Match { namespace, match_string: string, scope, action }
};

pub Scope: String = {
    "in" <glob: StringLiteral> => glob
};

pub Namespace: Namespace = {
    <lang: Identifier> "::" <module: Identifier> => Namespace { lang, module }
};

pub Action: Action = {
    "replace" <string: StringLiteral> => Action::Replace(string),
    "delete" => Action::Delete,
    "ensure" => Action::Ensure,
    "replace_call" <string: StringLiteral> => Action::ReplaceCall(string),
};

// Namespace segments may be spelled like DSL keywords: a backend's
// module is named after the language's own construct, and C's is
// `#include`. Listing the keyword terminals here lets `c::include` parse
// as a namespace while `include "pack.codemod"` at item level still
// reads as the directive — the two positions are never ambiguous,
// because a namespace only ever follows `match`.
pub Identifier: String = {
    <s: r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string(),
    "include" => "include".to_string(),
    "delete" => "delete".to_string(),
    "ensure" => "ensure".to_string(),
    "replace" => "replace".to_string(),
    "in" => "in".to_string(),
};

pub StringLiteral: String = {
    // Match opening quote, characters inside, and closing quote
     <s:r#""[^"]*""#> => s.trim_matches('"').to_string()
};
