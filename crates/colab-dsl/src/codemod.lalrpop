use crate::ast::Command;
use crate::ast::Item;
use crate::ast::Match;
use crate::ast::Namespace;
use crate::ast::Action;
use crate::ast::Span;
use crate::ast::ImportClause;
use crate::ast::{Clause, Fences, Location};
use colab_core::{Constraint, Relation, Stop, Test, TransformArg, Var};
use crate::ast::Let;
use lalrpop_util::ParseError;

grammar;

// Skip whitespace and `//` line comments. Block comments are
// intentionally not supported (yet) — they encourage commented-out
// rules, which we'd rather see deleted.
match {
    r"\s+" => { },
    r"//[^\n\r]*" => { },
} else {
    _
}

pub Program: Command = {
    "refactor" <name: StringLiteral> "{" <items: Item*> "}" => Command { refactor_name: name, items }
};

pub Item: Item = {
    <m: Match> => Item::Match(m),
    "include" <s: StringLiteral> => Item::Include(s),
    // `pattern helper = '…'`: a pattern `where` clauses name.
    <start: @L> "pattern" <name: Identifier> "=" <text: StringLiteral> <end: @R> => Item::Pattern { name, text, span: Span { start, end } },
    // `scan <lang>::pattern '<p>' [in "<glob>"] [where …] as <name>`: a
    // read-only phase whose bindings `where $X in <name>` can use.
    <start: @L> "scan" <namespace: Namespace> <pattern: StringLiteral> <locations: Location*> <constraints: Where?> "as" <name: Identifier> <end: @R> =>? {
        let (scope, _, _) = crate::ast::locations(locations).map_err(|error| ParseError::User { error })?;
        Ok(Item::Scan(crate::ast::Scan { namespace, pattern, scope, constraints: constraints.unwrap_or_default(), name, span: Span { start, end } }))
    },
    // `then { … }`: what runs after everything before it, over every file.
    "then" "{" <items: Item*> "}" => Item::Then(items),
    // `rewriter opt = '<pattern>' -> '<template>'`: what a `let`'s
    // `rewrite(opt)` step does to each match inside a binding.
    <start: @L> "rewriter" <name: Identifier> "=" <pattern: StringLiteral> "->" <template: StringLiteral> <end: @R> => Item::Rewriter { name, pattern, template, span: Span { start, end } },
};

// The optional `in "<glob>"` clause restricts the rule to matching
// paths. It is enforced through the operation's relevance check, so a
// scoped rule is skipped wholesale for files outside the glob.
//
// The optional `where` clause narrows a `<lang>::pattern` match; import
// clauses after the action run only on the files the rule changed.
pub Match: Match = {
    <start: @L> "match" <namespace: Namespace> <string: StringLiteral> <locations: Location*> <constraints: Where?> "{" <lets: Let*> <action: Action> <clauses: Clause*> "}" <end: @R> =>? {
        let (scope, fences, prose) = crate::ast::locations(locations)
            .map_err(|error| ParseError::User { error })?;
        let crate::ast::Clauses { imports, message, severity, id, url } = crate::ast::clauses(clauses)
            .map_err(|error| ParseError::User { error })?;
        Ok(Match { namespace, match_string: string, scope, fences, prose, message, severity, id, url, constraints: constraints.unwrap_or_default(), lets, action, imports, span: Span { start, end } })
    }
};

// Where a rule applies: `in "<glob>"` narrows it by path; `in fences`
// moves it into the matching Markdown code fences, and `and fences` adds
// them to the rule's own files. Each may appear once.
Location: Location = {
    "in" <glob: StringLiteral> => Location::Glob(glob),
    "in" "fences" => Location::Fences(Fences::Only),
    "and" "fences" => Location::Fences(Fences::Also),
    "and" "prose" => Location::Prose,
};

Where: Vec<Constraint> = {
    "where" <first: Constraint> <rest: ("," <Constraint>)*> => {
        let mut all = vec![first];
        all.extend(rest);
        all
    }
};

pub Constraint: Constraint = {
    "not" <test: Test> => Constraint { negated: true, test },
    <test: Test> => Constraint { negated: false, test },
};

Test: Test = {
    <var: Metavar> "matches" <regex: Regex> => Test::Matches { var, regex },
    <var: Metavar> "matches" <regex: StringLiteral> => Test::Matches { var, regex },
    <var: Metavar> "is" <kind: Identifier> => Test::Is { var, kind },
    <var: Metavar> "is" <kind: StringLiteral> => Test::Is { var, kind },
    <var: Metavar> "in" <set: Identifier> => Test::In { var, set, field: None },
    <var: Metavar> "in" <set: Identifier> "." <field: Metavar> => Test::In { var, set, field: Some(field) },
    <var: Metavar> "type" <ty: StringLiteral> => Test::Semantic { var, query: colab_core::semantic::Query::Type(ty) },
    <var: Metavar> "resolves" <target: StringLiteral> => Test::Semantic { var, query: colab_core::semantic::Query::Resolves(target) },
    <var: Metavar> "implements" <target: StringLiteral> => Test::Semantic { var, query: colab_core::semantic::Query::Implements(target) },
    <var: Metavar> "calls" <target: StringLiteral> => Test::Semantic { var, query: colab_core::semantic::Query::Calls(target) },
    <var: Metavar> "called_by" <target: StringLiteral> => Test::Semantic { var, query: colab_core::semantic::Query::CalledBy(target) },
    <var: Metavar> "count" <range: CountRange> => Test::Count { var, min: range.0, max: range.1 },
    "inside" <pattern: PatternArg> => Test::Inside(pattern),
    "has" <pattern: PatternArg> => Test::Has(pattern),
    "inside" <pattern: PatternArg> <stop: StopClause> => Test::Related { relation: Relation::Inside, pattern, stop },
    "has" <pattern: PatternArg> <stop: StopClause> => Test::Related { relation: Relation::Has, pattern, stop },
    "follows" <pattern: PatternArg> <stop: StopClause?> => Test::Related { relation: Relation::Follows, pattern, stop: stop.unwrap_or(Stop::Anywhere) },
    "precedes" <pattern: PatternArg> <stop: StopClause?> => Test::Related { relation: Relation::Precedes, pattern, stop: stop.unwrap_or(Stop::Anywhere) },
    "any" "(" <all: Constraints> ")" => Test::Any(all),
    "all" "(" <all: Constraints> ")" => Test::All(all),
    "nth" <n: Number> => Test::Nth(i64::try_from(n).unwrap_or(i64::MAX)),
    "nth" "-" <n: Number> => Test::Nth(-i64::try_from(n).unwrap_or(i64::MAX)),
    "field" <name: Identifier> => Test::Field(name),
};

// How far `inside` / `has` / `follows` / `precedes` look.
StopClause: Stop = {
    "directly" => Stop::Directly,
    "until" <pattern: PatternArg> => Stop::Until(pattern),
};

// A pattern in quotes, or the name of one defined with `pattern`.
PatternArg: String = {
    <StringLiteral>,
    <name: Identifier> => colab_core::constraint::named_pattern(&name),
};

Constraints: Vec<Constraint> = {
    <first: Constraint> <rest: ("," <Constraint>)*> => {
        let mut all = vec![first];
        all.extend(rest);
        all
    }
};

// `let $NAME = $F | strip_prefix("Get") | snake`: a value for the
// `replace` template, derived from a binding (or an earlier `let`).
// Step names are checked when the rule is compiled, so a misspelt one is
// reported on its rule.
Let: Let = {
    "let" <var: Metavar> "=" <from: Metavar> <steps: ("|" <Step>)+> => Let { var, from, steps },
};

Step: (String, Vec<TransformArg>) = {
    <name: Identifier> => (name, Vec::new()),
    <name: Identifier> "(" <args: Comma<StepArg>> ")" => (name, args),
};

StepArg: TransformArg = {
    <s: StringLiteral> => TransformArg::Text(s),
    <r: Regex> => TransformArg::Regex(r),
    <n: Number> => TransformArg::Int(i64::try_from(n).unwrap_or(i64::MAX)),
    "-" <n: Number> => TransformArg::Int(-i64::try_from(n).unwrap_or(i64::MAX)),
    <name: Identifier> => TransformArg::Name(name),
};

Comma<T>: Vec<T> = {
    <mut v: (<T> ",")*> <e: T?> => match e {
        None => v,
        Some(e) => { v.push(e); v }
    }
};

// `count 2`, `count 1..3`, `count 1..` (no upper bound), `count ..3`.
CountRange: (usize, Option<usize>) = {
    <n: Number> => (n, Some(n)),
    <n: Number> ".." <m: Number> => (n, Some(m)),
    <n: Number> ".." => (n, None),
    ".." <m: Number> => (0, Some(m)),
};

Number: usize = {
    <s: r"[0-9]+"> => s.parse().unwrap_or(usize::MAX),
};

// `$NAME` or `$$$NAME`, as in the pattern.
Metavar: Var = {
    <s: r"\$(\$\$)?[A-Z_][A-Z0-9_]*"> => Var::parse(s).unwrap_or(Var { name: s.trim_start_matches('$').to_string(), multi: s.starts_with("$$$") }),
};

// `/re/`, with `\/` for a literal slash. Never `//`, which starts a comment.
Regex: String = {
    <s: r"/([^/\\\n\r]|\\.)+/"> => s[1..s.len() - 1].to_string(),
};

// After the action: import clauses, and how a rule reports what it finds.
Clause: Clause = {
    <ImportClause> => Clause::Import(<>),
    "message" <text: StringLiteral> => Clause::Message(text),
    "severity" <level: Identifier> => Clause::Severity(level),
    "id" <id: StringLiteral> => Clause::Id(id),
    "url" <url: StringLiteral> => Clause::Url(url),
};

ImportClause: ImportClause = {
    "requires" "import" <path: StringLiteral> => ImportClause::Requires(path),
    "drops" "import" <path: StringLiteral> "when" "unused" => ImportClause::DropsUnused(path),
};

pub Namespace: Namespace = {
    <lang: Identifier> "::" <module: Identifier> => Namespace { lang, module }
};

pub Action: Action = {
    "replace" <string: StringLiteral> => Action::Replace(string),
    "delete" => Action::Delete,
    "ensure" => Action::Ensure,
    "replace_call" <string: StringLiteral> => Action::ReplaceCall(string),
    "set" <string: StringLiteral> => Action::Set(string),
    "insert" <string: StringLiteral> => Action::Insert(string),
};

// Namespace segments may be spelled like DSL keywords: a backend's
// module is named after the language's own construct, and C's is
// `#include`. Listing the keyword terminals here lets `c::include` parse
// as a namespace while `include "pack.colab"` at item level still
// reads as the directive — the two positions are never ambiguous,
// because a namespace only ever follows `match`.
pub Identifier: String = {
    <s: r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string(),
    "include" => "include".to_string(),
    "delete" => "delete".to_string(),
    "ensure" => "ensure".to_string(),
    "replace" => "replace".to_string(),
    "in" => "in".to_string(),
    "set" => "set".to_string(),
    "insert" => "insert".to_string(),
    "where" => "where".to_string(),
    "not" => "not".to_string(),
    "matches" => "matches".to_string(),
    "is" => "is".to_string(),
    "count" => "count".to_string(),
    "inside" => "inside".to_string(),
    "has" => "has".to_string(),
    "requires" => "requires".to_string(),
    "import" => "import".to_string(),
    "drops" => "drops".to_string(),
    "when" => "when".to_string(),
    "unused" => "unused".to_string(),
    "fences" => "fences".to_string(),
    "prose" => "prose".to_string(),
    "message" => "message".to_string(),
    "severity" => "severity".to_string(),
    "and" => "and".to_string(),
    "let" => "let".to_string(),
    "follows" => "follows".to_string(),
    "precedes" => "precedes".to_string(),
    "directly" => "directly".to_string(),
    "until" => "until".to_string(),
    "any" => "any".to_string(),
    "all" => "all".to_string(),
    "nth" => "nth".to_string(),
    "field" => "field".to_string(),
    "pattern" => "pattern".to_string(),
    "rewriter" => "rewriter".to_string(),
    "id" => "id".to_string(),
    "url" => "url".to_string(),
    "type" => "type".to_string(),
    "resolves" => "resolves".to_string(),
    "implements" => "implements".to_string(),
    "calls" => "calls".to_string(),
    "called_by" => "called_by".to_string(),
    "scan" => "scan".to_string(),
    "as" => "as".to_string(),
    "then" => "then".to_string(),
};

// Three spellings, none with escapes. A double-quoted string cannot
// contain `"`; a single-quoted one cannot contain `'`. Single quotes exist
// for values that are themselves quoted text — a TOML inline table or a
// JSON object passed to `set` / `insert`. A raw string, `r#"…"#`, may
// contain both (Markdown about code, a template with a lifetime and a
// string); it ends at the first `"#`, so its text cannot contain `"#`. `r##"…"##` ends at the first `"##`, for text that
// mentions `"#` (documentation of raw strings). Two hashes is the limit:
// LALRPOP quotes each token's regex in an `r###` string in the code it
// generates. All may span lines.
pub StringLiteral: String = {
    <s:r#""[^"]*""#> => s[1..s.len() - 1].to_string(),
    <s:r#"'[^']*'"#> => s[1..s.len() - 1].to_string(),
    <s:r##"r#"([^"]|"+[^"#])*"+#"##> => s[3..s.len() - 2].to_string(),
    <s:r###"r##"([^"]|"+[^"#]|"+#[^"#])*"+##"###> => s[4..s.len() - 3].to_string(),
};
